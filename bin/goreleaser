#!/usr/bin/env bash
# goreleaser wrapper — loads license key and ensures binary is installed
# The real binary lives at bin/.goreleaser-pro (installed by: forgectl install)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
BIN="$SCRIPT_DIR/.goreleaser-pro"
KEY_FILE="$SCRIPT_DIR/.goreleaser-key"

# Ensure binary is installed
if [[ ! -x "$BIN" ]]; then
  forgectl install >&2
fi

# Load license key: prefer env var, fall back to cached file
if [[ -z "${GORELEASER_KEY:-}" ]]; then
  if [[ -f "$KEY_FILE" ]]; then
    export GORELEASER_KEY
    GORELEASER_KEY="$(cat "$KEY_FILE")"
  else
    echo "warning: goreleaser key not found at $KEY_FILE and GORELEASER_KEY not set" >&2
  fi
fi

exec "$BIN" "$@"
